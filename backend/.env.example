# =================================
# DDYs Backend Environment Variables
# =================================
# Copy this file to .env and fill in your values

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=ddys_compliance

# JWT Authentication
JWT_SECRET=your-secure-random-secret-min-32-chars
JWT_EXPIRY_HOURS=12

# MFA
MFA_ISSUER=DDYs Compliance

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# LLM / AI Integration
EMERGENT_LLM_KEY=your-emergent-api-key
LLM_PROVIDER=emergent
LLM_MODEL=claude-sonnet-4-20250514

# File Storage (gcs | local)
# Production should always be 'gcs' (Swiss data residency, europe-west6).
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=/app/backend/uploads
# For GCS:
# STORAGE_TYPE=gcs
# GCP_PROJECT_ID=ddys-prod
# GCP_REGION=europe-west6
# GCS_BUCKET_PREFIX=ddys
# GCS_DEFAULT_BUCKET=                # leave blank to auto-detect by prefix
# GCS_PER_TENANT_BUCKETS=false       # set 'true' to use one bucket per tenant

# Migrations
RUN_MIGRATIONS_ON_STARTUP=true

# Providers
# Email
EMAIL_PROVIDER=mock                  # mock | sendgrid
# SENDGRID_API_KEY=SG.xxxxx
# EMAIL_FROM=noreply@ddys.com
# EMAIL_FROM_NAME=DDYs Compliance

# Identity Verification
KYC_PROVIDER=mock                    # mock | didit
# DIDIT_API_KEY=
# DIDIT_API_SECRET=
# DIDIT_BASE_URL=https://api.didit.me/v1
# DIDIT_WEBHOOK_SECRET=

# Screening
SCREENING_PROVIDER=mock              # mock | worldcheck | complyadvantage

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
