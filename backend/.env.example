# =================================
# DDYs Backend Environment Variables
# =================================
# Copy this file to .env and fill in your values

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=ddys_compliance

# JWT Authentication
JWT_SECRET=your-secure-random-secret-min-32-chars
JWT_EXPIRY_HOURS=12

# MFA
MFA_ISSUER=DDYs Compliance

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# LLM / AI Integration
EMERGENT_LLM_KEY=your-emergent-api-key
LLM_PROVIDER=emergent
LLM_MODEL=claude-sonnet-4-20250514

# File Storage
STORAGE_TYPE=local
# For S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=ddys-documents
# AWS_REGION=eu-central-1

# Email Integration (optional)
# SENDGRID_API_KEY=your-sendgrid-key
# RESEND_API_KEY=your-resend-key
# EMAIL_FROM=noreply@ddys.com

# Screening Provider (optional)
# SCREENING_PROVIDER=mock
# DIDIT_API_KEY=your-didit-key

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
ENVIRONMENT=development
